# Which broker to use: "alpaca" or "robinhood"
JUNOBOT_BROKER=alpaca

# Alpaca credentials — get from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=
# "true" for paper trading, "false" for live. Default true.
ALPACA_PAPER=true

# Robinhood (not yet implemented)
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA_SECRET=
