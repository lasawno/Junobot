# API Server Configuration
PORT=5000
HOST=localhost
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/junobot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=junobot
DB_USER=postgres
DB_PASSWORD=password

# Trading Configuration
ACCOUNT_ID=
API_KEY=
API_SECRET=
TRADING_MODE=PAPER
LEVERAGE=1

# Market Data Configuration
MARKET_DATA_PROVIDER=alfaca
MARKET_DATA_INTERVAL=60

# Camofox Configuration
CAMOUFOX_EXECUTABLE=/usr/bin/camoufox
CAMOUFOX_HEADLESS=true
CAMOUFOX_ANTI_DETECTION=true
CAMOUFOX_PROXY=

# Kronos Configuration
KRONOS_ENABLED=true
KRONOS_LOG_EXECUTIONS=true

# WebSocket Configuration
WS_PORT=5000
WS_RECONNECT_INTERVAL=3000

# Email Notifications (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=
